# JAGGU Backend Proxy Server Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Optional: Bearer authentication secret required by client (leave empty for open/local dev)
SERVER_AUTH_SECRET=

# Default Provider to route requests to if not specified by model name
# Options: huggingface | openai | anthropic | gemini | ollama | mock
DEFAULT_PROVIDER=huggingface

# Backend API Keys (Users do NOT need to provide these)
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama Host URL (if routing to local/server Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
