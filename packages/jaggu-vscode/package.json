{
  "name": "jaggu-vscode",
  "displayName": "JAGGU",
  "description": "JAGGU — Autonomous AI Coding Agent for VS Code",
  "version": "0.1.0",
  "publisher": "jaggu",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "type": "module",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jaggu-activity-bar",
          "title": "JAGGU",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "jaggu-activity-bar": [
        {
          "type": "webview",
          "id": "jaggu.sidebarView",
          "name": "JAGGU Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "jaggu.openChat",
        "title": "JAGGU: Open Chat",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.startSession",
        "title": "JAGGU: Start New Session",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.cancelSession",
        "title": "JAGGU: Cancel Active Task",
        "category": "JAGGU"
      }
    ],
    "configuration": {
      "title": "JAGGU",
      "properties": {
        "jaggu.provider": {
          "type": "string",
          "default": "mock",
          "description": "Active AI provider for JAGGU ('mock', 'ollama', 'openai-compatible', 'openai', 'anthropic', 'gemini')"
        },
        "jaggu.model": {
          "type": "string",
          "default": "mock-fast",
          "description": "Active AI model ID"
        },
        "jaggu.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for local Ollama server"
        },
        "jaggu.openaiCompatible.endpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "Base URL for local or custom OpenAI-compatible server (vLLM, LM Studio, etc.)"
        },
        "jaggu.model.contextLimit": {
          "type": "number",
          "default": 0,
          "description": "Manual override for max context window tokens (0 = use model default)"
        },
        "jaggu.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Sampling temperature for model generation"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jaggu/core": "*",
    "@jaggu/ui": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
