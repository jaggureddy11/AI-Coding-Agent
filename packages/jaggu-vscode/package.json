{
  "name": "jaggu-vscode",
  "displayName": "JAGGU — Autonomous AI Coding Agent",
  "description": "Developer-controlled autonomous AI coding agent for VS Code. Understands repositories, formulates plans, executes verified multi-file edits, and self-heals errors.",
  "version": "0.1.0",
  "publisher": "jaggu",
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaggureddy11/AI-Coding-Agent"
  },
  "homepage": "https://github.com/jaggureddy11/AI-Coding-Agent#readme",
  "bugs": {
    "url": "https://github.com/jaggureddy11/AI-Coding-Agent/issues"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "coding-agent",
    "autonomous-agent",
    "developer-tools",
    "llm",
    "ollama",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:jaggu.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jaggu-activity-bar",
          "title": "JAGGU",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "jaggu-activity-bar": [
        {
          "type": "webview",
          "id": "jaggu.sidebarView",
          "name": "JAGGU"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jaggu.startSession",
          "when": "view == jaggu.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "jaggu.setApiKey",
          "when": "view == jaggu.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "jaggu.selectProvider",
          "when": "view == jaggu.sidebarView",
          "group": "navigation@3"
        }
      ]
    },
    "commands": [
      {
        "command": "jaggu.openChat",
        "title": "JAGGU: Open Chat",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.startSession",
        "title": "JAGGU: Start New Session",
        "icon": "$(add)",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.cancelSession",
        "title": "JAGGU: Cancel Active Task",
        "icon": "$(stop-circle)",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.setApiKey",
        "title": "JAGGU: Manage API Keys (SecretStorage)",
        "icon": "$(key)",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.setHuggingFaceToken",
        "title": "JAGGU: Set Hugging Face Token",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.removeHuggingFaceToken",
        "title": "JAGGU: Remove Hugging Face Token",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.testHuggingFaceConnection",
        "title": "JAGGU: Test Hugging Face Connection",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.selectProvider",
        "title": "JAGGU: Select Model Provider",
        "icon": "$(server)",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.selectModel",
        "title": "JAGGU: Select Active Model",
        "category": "JAGGU"
      },
      {
        "command": "jaggu.reviewDiff",
        "title": "JAGGU: Review Proposed Diff",
        "category": "JAGGU"
      }
    ],
    "configuration": {
      "title": "JAGGU",
      "properties": {
        "jaggu.modelMode": {
          "type": "string",
          "enum": ["auto", "free-and-local", "local-only", "manual"],
          "default": "auto",
          "description": "JAGGU Model Mode. 'auto' selects best free/open model (Qwen3-Coder) -> local Ollama -> fallback."
        },
        "jaggu.allowPaidFallbackInAuto": {
          "type": "boolean",
          "default": false,
          "description": "Allow automatic fallback to configured paid models (OpenAI, Anthropic, Gemini) if all free/local models are unavailable. (Default: false)"
        },
        "jaggu.allowPaidFallback": {
          "type": "boolean",
          "default": false,
          "description": "Allow automatic fallback to configured paid models (OpenAI, Anthropic, Gemini) if all free/local models are unavailable. (Default: false)"
        },
        "jaggu.localOnly": {
          "type": "boolean",
          "default": false,
          "description": "Strictly restrict JAGGU to offline local runtimes (Ollama / local servers). Never contact cloud providers."
        },
        "jaggu.provider": {
          "type": "string",
          "default": "auto",
          "description": "Active AI provider for JAGGU ('auto', 'huggingface', 'ollama', 'openai-compatible', 'openai', 'anthropic', 'gemini', 'mock')"
        },
        "jaggu.model": {
          "type": "string",
          "default": "auto",
          "description": "Active AI model ID ('auto' for intelligent routing, or specific model identifier)"
        },
        "jaggu.huggingface.endpoint": {
          "type": "string",
          "default": "https://router.huggingface.co/v1",
          "description": "Base URL for Hugging Face Inference Router"
        },
        "jaggu.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for local Ollama server"
        },
        "jaggu.openaiCompatible.endpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "Base URL for local or custom OpenAI-compatible server (vLLM, LM Studio, etc.)"
        },
        "jaggu.maxContextTokens": {
          "type": "number",
          "default": 0,
          "description": "Maximum workspace context token budget (0 = automatic based on model limit)"
        },
        "jaggu.maxRepairAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum autonomous self-repair attempts if verification tests or compilation fails"
        },
        "jaggu.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable language server diagnostics collection for self-healing verification"
        },
        "jaggu.enableVerification": {
          "type": "boolean",
          "default": true,
          "description": "Enable automated test execution and verification after applying code changes"
        },
        "jaggu.model.contextLimit": {
          "type": "number",
          "default": 0,
          "description": "Manual override for max context window tokens (0 = use model default)"
        },
        "jaggu.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Sampling temperature for model generation"
        }
      }
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --format=cjs --sourcemap --banner:js=\"const import_meta_url = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=import_meta_url",
    "build": "tsc -b && npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jaggu/core": "*",
    "@jaggu/ui": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5"
  }
}
