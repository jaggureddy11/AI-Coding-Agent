{
  "name": "@jaggu/ui",
  "version": "0.1.0",
  "description": "React-based Webview UI foundation for JAGGU",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/main.tsx --bundle --outfile=../jaggu-vscode/media/webview.js --format=iife --target=es2022 --minify --sourcemap --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "tsc -b && npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jaggu/core": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
